# YOLO Pipeline Environment Variables
# Copy this file to .env and modify the values as needed

# Data folder for FiftyOne datasets
DATA_FOLDER=data

# Dataset names
TRAIN_DATASET_NAME=train_5000
VAL_DATASET_NAME=val_500
TEST_DATASET_NAME=test_500

# YOLO training folder path
YOLO_TRAIN_FOLDER=data/yolo/train

# Best model path
YOLO_BEST_MODEL_PATH=yolo/runs/optuna/best_model.pt

# Training parameters
NUM_TRAIN=1500
NUM_VAL=150
NUM_TEST=150
N_TRIALS=20

# Optuna optimization ranges
EPOCHS_MIN=50
EPOCHS_MAX=150
LR0_MIN=0.0001
LR0_MAX=0.01
LRF_MIN=0.01
LRF_MAX=0.5

# Model parameters
MODEL_NAME=yolov8s.pt

WORKERS=8
IMAGE_SIZE=1024
BATCH_SIZE=16
# augmentation
DEGREES=10.0         # rotación moderada
TRANSLATE=0.1        # traslación ligera
SCALE=0.5            # zoom 0.5x-1.5x
SHEAR=2.0            # shear mínimo
PERSPECTIVE=0.0001   # perspectiva ligera
FLIPUD=0.0           # solo si objetos pueden estar invertidos
FLIPLR=0.5           # flip horizontal por defecto

# Color
HSV_H=0.015          # por defecto
HSV_S=0.7            # por defecto
HSV_V=0.4            # por defecto

# Mixing (IMPORTANTE para datasets pequeños)
MOSAIC=1.0           # activo
MIXUP=0.15           # añade mixup
CLOSE_MOSAIC=10      # desactiva mosaic últimas 10 épocas




# Classes to train
CLASSES=Cat,Dog
