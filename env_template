# YOLO Pipeline Environment Variables
# Copy this file to .env and modify the values as needed

# Data folder for FiftyOne datasets
DATA_FOLDER=data

# Dataset names
TRAIN_DATASET_NAME=train_5000
VAL_DATASET_NAME=val_500
TEST_DATASET_NAME=test_500

# YOLO training folder path
YOLO_TRAIN_FOLDER=data/yolo/train

# YOLO image folders
YOLO_TRAIN_IMAGES=data/yolo/train/images/train
YOLO_VAL_IMAGES=data/yolo/val/images/val
YOLO_TEST_IMAGES=data/yolo/test/images/test

# Best model path
YOLO_BEST_MODEL_PATH=yolo/runs/optuna/best_model.pt

# Training parameters
NUM_TRAIN=1500
NUM_VAL=150
NUM_TEST=150
N_TRIALS=20

# Training parameters
EPOCHS=100           # número fijo de épocas por trial

# Optuna optimization ranges (solo lr0 y lrf)
LR0_MIN=0.0001
LR0_MAX=0.01
LRF_MIN=0.01
LRF_MAX=0.5

# Model parameters
# 

WORKERS=8
IMAGE_SIZE=1024
BATCH_SIZE=16

# Augmentation parameters
# NOTA: degrees, translate, scale, shear, hsv_s, hsv_v, mixup se optimizan con Optuna
# Los siguientes son valores fijos que NO se optimizan:
PERSPECTIVE=0.0001   # perspectiva ligera
FLIPUD=0.0           # solo si objetos pueden estar invertidos
FLIPLR=0.5           # flip horizontal por defecto
HSV_H=0.015          # hue (por defecto)
MOSAIC=1.0           # activo
CLOSE_MOSAIC=10      # desactiva mosaic últimas 10 épocas




# Classes to train
CLASSES=Cat,Dog
